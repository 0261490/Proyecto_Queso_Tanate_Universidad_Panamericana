{
  "name": "@proyecto-tenate/pwa-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/generate-service-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** tests/*.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "fake-indexeddb": "6.2.8",
    "vite": "7.3.7"
  }
}
